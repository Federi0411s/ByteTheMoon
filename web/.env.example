# Copy to .env.local (gitignored) and fill in.
# Cesium ion token: for the public deployment, create a token restricted to the Cesium Moon asset
# and to your site's domain (ion.cesium.com -> Access Tokens -> Allowed URLs).
VITE_CESIUM_ION_TOKEN=
# Cesium Moon asset ID as shown in ion "My Assets"
VITE_CESIUM_MOON_ASSET_ID=2684829
# Set to "trek" to skip Cesium ion and use the NASA Moon Trek basemap on a smooth globe.
VITE_BASEMAP=ion
# Base URL of the fine elevation tiles (levels 6-7 from pipeline/dem_tiles.py, served as {z}/{x}/{y}.webp
# from a CORS-open static bucket). Leave unset: dev uses /dem-fine, production falls back to 666 m tiles.
# Set to "none" to disable them in dev too.
# VITE_DEM_FINE_URL=https://<bucket>/dem_fine
# The precomputed slope and sky-view fine tiles default to the sibling folders <bucket>/slope_fine and
# <bucket>/sky_fine; override them separately if they live elsewhere ("none" disables them).
# VITE_SLOPE_FINE_URL=https://<bucket>/slope_fine
# VITE_SKY_FINE_URL=https://<bucket>/sky_fine
# VITE_HORIZON_FINE_URL=https://<bucket>/horizon_fine
